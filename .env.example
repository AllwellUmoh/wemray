# Neon / Postgres
# Must be exposed as DATABASE_URL. Prefixed Neon integration variables such as
# wemray_DATABASE_URL are not read by the app.
DATABASE_URL=postgresql://user:password@host/dbname?channel_binding=require&sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/dbname?sslmode=require

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=hello@wemray.com

# Resend
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=Wemray Technology <no-reply@mail.wemray.com>
CONTACT_NOTIFICATION_EMAIL=hello@mail.wemray.com

# Contact form
CONTACT_IP_SALT=replace-with-a-random-string

# Paystack (Ray Academy enrolments)
PAYSTACK_SECRET_KEY=sk_test_replace_me
# Optional: defaults to ${NEXT_PUBLIC_SITE_URL}/api/academy/enrolments/verify
PAYSTACK_CALLBACK_URL=
# Days between the two instalments
ACADEMY_INSTALMENT_DAYS=30

# RAY SEO Analyser
CONTACT_ENCRYPTION_KEY=replace-with-a-32-byte-hex-key
SEO_HASH_SALT=replace-with-a-random-string
PAGESPEED_API_KEY=
SEO_REPORT_TTL_DAYS=30
SEO_AUDIT_RETENTION_DAYS=90
SEO_CONSENT_RETENTION_MONTHS=24
SEO_IP_HOURLY_LIMIT=5
SEO_IP_DAILY_LIMIT=15
SEO_CONTACT_DAILY_LIMIT=5
SEO_GLOBAL_DAILY_LIMIT=100

# Set to true only on a persistent Node host. Leave unset/false on Vercel so the
# audit runs inside the request instead of a background job.
ENABLE_INLINE_AUDIT_JOBS=false
